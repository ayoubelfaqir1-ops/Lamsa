# ==============================================================================
# Lamsa.ma - Production Environment Configuration Template
# Copy this file to .env on your production server: cp .env.production.example .env
# ==============================================================================

APP_NAME="Lamsa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Casablanca
APP_URL=https://api.lamsa.ma
FRONTEND_URL=https://lamsa.ma

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Logging Configuration (Daily log rotation to avoid huge log files)
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Production MySQL Database Connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lamsa_production
DB_USERNAME=lamsa_user
DB_PASSWORD=your_strong_database_password_here

# Redis Configuration (Used for Caching, Sessions, and Queues)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=lamsa_cache

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.lamsa.ma

# Queue Worker Configuration
QUEUE_CONNECTION=redis

# File Storage & Media Configuration (AWS S3)
FILESYSTEM_DISK=local
MEDIA_DISK=s3

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=lamsa-production-media
AWS_URL=https://cdn.lamsa.ma
AWS_USE_PATH_STYLE_ENDPOINT=false

# Transactional Email (Resend or Brevo)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_login
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@lamsa.ma"
MAIL_FROM_NAME="Lamsa"

# Real-Time WebSocket Server (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=your_reverb_app_id
REVERB_APP_KEY=your_reverb_app_key
REVERB_APP_SECRET=your_reverb_app_secret
REVERB_HOST="ws.lamsa.ma"
REVERB_PORT=443
REVERB_SCHEME=https

# Sanctum Authentication Token Lifetime (in minutes: 10080 = 7 days)
SANCTUM_EXPIRATION=10080

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI="https://api.lamsa.ma/api/v1/auth/google/callback"

