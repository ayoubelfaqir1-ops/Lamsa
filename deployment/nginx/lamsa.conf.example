# /etc/nginx/sites-available/lamsa.ma

# 1. Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name api.lamsa.ma;

    return 301 https://$host$request_uri;
}

# 2. Production HTTPS Server Block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.lamsa.ma;

    root /var/www/Lamsa.ma/public;
    index index.php;

    # SSL Certificates (managed via Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/api.lamsa.ma/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.lamsa.ma/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Include Global Security Headers
    include /var/www/Lamsa.ma/deployment/nginx/security-headers.conf;

    charset utf-8;
    client_max_body_size 20M;

    # Static Assets Caching
    location ~* \.(ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform, immutable";
        access_log off;
    }

    # API and Dynamic Requests to PHP-FPM
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # PHP-FPM FastCGI Handler
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # Block access to hidden files (.env, .git, etc.)
    location ~ /\.(?!well-known).* {
        deny all;
    }
}

